<mujoco model="tetraedro_invertido">
  <!--
    Variante do Experimento 01 — tetraedro regular (4 faces triangulares) com a PONTA para baixo.

    Aresta a = 0.40 m → altura H = a·√(2/3) = 0.32660 m. Coordenadas relativas ao centroide:
        base (face de cima, horizontal):  z = +H/4 = +0.08165, círculo de raio a/√3 = 0.23094
        ponta (vértice de baixo):         z = -3H/4 = -0.24495
    Volume = a³/(6√2) = 7.5425e-3 m³ → massa = 7.5425 kg (densidade 1000 kg/m³).
    Em repouso, apoia-se numa face: altura do centro de massa = raio inscrito = a·√6/12 = 0.08165 m.
    Mesma cena, física e contato do triangulo_invertido.xml (só muda a malha).
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.65 0.65 0.65" specular="0.05 0.05 0.05"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <!-- setas/discos de contato (flags mjVIS_CONTACT*): finos para não cobrir o objeto -->
    <scale contactwidth="0.08" contactheight="0.02" forcewidth="0.04"/>
    <map force="0.002"/>
  </visual>
  <statistic center="0 0 0.45" extent="1.7"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.50 0.72 0.95" rgb2="0.03 0.05 0.10" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.19 0.23 0.29" rgb2="0.27 0.32 0.39"
             width="512" height="512" mark="edge" markrgb="0.55 0.60 0.66"/>
    <material name="piso" texture="grade" texrepeat="5 5" texuniform="true" reflectance="0.12"/>
    <material name="verde" rgba="0.20 0.78 0.55 1" specular="0.35" shininess="0.5"/>
    <mesh name="tetraedro" vertex="
       0.00000  0.23094  0.08165
      -0.20000 -0.11547  0.08165
       0.20000 -0.11547  0.08165
       0.00000  0.00000 -0.24495"/>
  </asset>

  <custom>
    <numeric name="esperado_massa_kg"       data="7.5425"/>    <!-- 1000 · a³/(6√2) -->
    <numeric name="esperado_altura_repouso" data="0.08165"/>   <!-- raio inscrito = a·√6/12, apoiado numa face -->
  </custom>

  <worldbody>
    <light name="sol" pos="1.5 -2.5 4" dir="-0.3 0.6 -1" type="directional" diffuse="0.85 0.85 0.85" specular="0.2 0.2 0.2"/>
    <camera name="frontal" pos="0 -2.15 0.60" xyaxes="1 0 0 0 0.04 1"/>

    <geom name="chao" type="plane" size="4 4 0.05" material="piso"
          friction="0.8 0.005 0.0001" solref="0.01 0.6"/>

    <!-- começa a 1.0 m, com a ponta para baixo e uma pequena inclinação para tornar o tombamento determinístico -->
    <body name="triangulo" pos="0 0 1.0" euler="6 -5 0">
      <freejoint name="livre"/>
      <geom name="tetraedro" type="mesh" mesh="tetraedro" material="verde"
            density="1000" friction="0.8 0.005 0.0001" solref="0.01 0.6"/>
      <site name="ponta"   type="sphere" pos=" 0.00  0.00 -0.24495" size="0.022" rgba="0.95 0.12 0.12 1"/>
      <site name="canto_a" type="sphere" pos=" 0.00  0.23094  0.08165" size="0.02" rgba="0.15 0.55 0.95 1"/>
      <site name="canto_b" type="sphere" pos="-0.20 -0.11547  0.08165" size="0.02" rgba="0.95 0.85 0.20 1"/>
      <site name="canto_c" type="sphere" pos=" 0.20 -0.11547  0.08165" size="0.02" rgba="0.85 0.35 0.95 1"/>
    </body>
  </worldbody>
</mujoco>
