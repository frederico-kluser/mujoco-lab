<mujoco model="braco_3gdl">
  <!--
    Braço robótico de 3 graus de liberdade: base fixa → yaw (eixo Z) → ombro (eixo Y) → cotovelo (eixo Y) → ponta (site "ponta").
    Servos <position> (PD): força = kp·(ctrl − q) − kv·q̇, limitada por forcerange. gravcomp="1" anula a gravidade nos elos (equivale a compensação de gravidade ideal).
    O corpo "alvo" é um corpo MOCAP (sem física, movido por data.mocap_pos): marca a posição desejada da ponta.
    Convenção do hinge em Y: ângulo POSITIVO leva +X para -Z (abaixa); para levantar o braço use ângulos negativos no ombro.
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.05 0.05 0.05"/>
  </visual>
  <statistic center="0.3 0 0.5" extent="1.4"/>

  <default>
    <joint damping="1.0" armature="0.01"/>
    <position kp="400" kv="40" forcerange="-120 120"/>
    <geom density="1000" rgba="0.85 0.86 0.9 1"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.50 0.72 0.95" rgb2="0.03 0.05 0.10" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.19 0.23 0.29" rgb2="0.27 0.32 0.39" width="512" height="512" mark="edge" markrgb="0.55 0.60 0.66"/>
    <material name="piso" texture="grade" texrepeat="5 5" texuniform="true" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="sol" pos="1 -2 4" dir="-0.2 0.5 -1" type="directional" diffuse="0.85 0.85 0.85"/>
    <camera name="frontal" pos="1.7 -1.9 0.95" xyaxes="0.75 0.66 0 -0.12 0.14 0.98"/>
    <geom name="chao" type="plane" size="4 4 0.05" material="piso"/>
    <geom name="pedestal" type="cylinder" size="0.08 0.15" pos="0 0 0.15" rgba="0.5 0.52 0.58 1" contype="0" conaffinity="0"/>

    <body name="base" pos="0 0 0.3" gravcomp="1">
      <joint name="yaw" type="hinge" axis="0 0 1" range="-170 170"/>
      <geom name="ombro_cil" type="cylinder" size="0.06 0.05" rgba="0.3 0.5 0.9 1"/>
      <body name="braco" pos="0 0 0.05" gravcomp="1">
        <joint name="ombro" type="hinge" axis="0 1 0" range="-100 60"/>
        <geom name="elo1" type="capsule" fromto="0 0 0  0.5 0 0" size="0.035" rgba="0.3 0.5 0.9 1"/>
        <body name="antebraco" pos="0.5 0 0" gravcomp="1">
          <joint name="cotovelo" type="hinge" axis="0 1 0" range="-10 150"/>
          <geom name="elo2" type="capsule" fromto="0 0 0  0.4 0 0" size="0.03" rgba="0.9 0.55 0.2 1"/>
          <site name="ponta" pos="0.4 0 0" size="0.02" rgba="1 0.1 0.1 1"/>
        </body>
      </body>
    </body>

    <!-- alvo: corpo mocap (apenas visual) -->
    <body name="alvo" mocap="true" pos="0.55 0 0.55">
      <geom type="sphere" size="0.025" rgba="0.2 0.9 0.4 0.55" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <!-- inheritrange="1": o ctrlrange herda o range da junta (já convertido para radianos pelo compilador) -->
    <position name="a_yaw"      joint="yaw"      inheritrange="1"/>
    <position name="a_ombro"    joint="ombro"    inheritrange="1"/>
    <position name="a_cotovelo" joint="cotovelo" inheritrange="1"/>
  </actuator>

  <sensor>
    <framepos name="pos_ponta" objtype="site" objname="ponta"/>
  </sensor>
</mujoco>
