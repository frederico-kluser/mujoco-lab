<mujoco model="lab_padrao_haste_alvo">
  <!--
    MODELO DE EXEMPLO do template `lab-padrao` (template base do laboratório).

    O que é: uma HASTE rígida com junta hinge no eixo Y (pivô fixo no mundo), accionada por UM atuador de
    torque (`<motor name="torque">`, ctrlrange ±30 N·m) e com um `site` na ponta (`ponta`) onde o `env.py`
    aplica a PERTURBAÇÃO externa ("vento"). É o análogo 1-DOF do drone a pairar: manter um ALVO (ângulo
    `theta_alvo`) contra a gravidade, com perturbação e com uma política RL a corrigir o erro.

    Convenções do laboratório: SI, +Z para cima, `<compiler angle="degree">` (o `qpos` da junta hinge é
    lido em RADIANOS na mesma), quaternions MuJoCo [w x y z].
    θ = 0 com a haste pendurada para baixo (-Z); θ = π com a haste em cima.

    ADAPTAR ao teu robô: troca o `<worldbody>`/atuadores por (1) o teu `models/<robo>/` vendorizado
    (carregado por MjSpec na camada `lab/<robo>.py`) ou (2) um MJCF simples como este. O que NÃO muda:
    os nomes que o `env.py` lê (`pivo`, `torque`, `ponta`) — ou então adapta-os em `env.py` (secção
    «nomes lidos do modelo», a única linha a mexer).
  -->
  <!-- Armadilha do laboratório (fica a nota para quem acrescentar peças): geom visual + colisão no MESMO corpo
       dobram a massa (`compiler inertiagrouprange` padrão `0 5`). Se acrescentares malhas visuais, põe-nas com
       `density="0"`/`mass="0"`, mete as de colisão no grupo 3 e usa `inertiagrouprange="3 3"`. -->
  <compiler angle="degree"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.35 0.37 0.4" diffuse="0.65 0.65 0.65" specular="0.05 0.05 0.05"/>
  </visual>
  <statistic center="0 0 1.0" extent="1.7"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.50 0.72 0.95" rgb2="0.03 0.05 0.10" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.19 0.23 0.29" rgb2="0.27 0.32 0.39" width="512" height="512" mark="edge" markrgb="0.55 0.60 0.66"/>
    <material name="piso" texture="grade" texrepeat="5 5" texuniform="true" reflectance="0.1"/>
    <material name="aco" rgba="0.86 0.87 0.91 1"/>
    <material name="laranja" rgba="0.96 0.47 0.10 1"/>
  </asset>

  <worldbody>
    <light name="sol" pos="1 -2 4" dir="-0.2 0.5 -1" type="directional" diffuse="0.85 0.85 0.85"/>
    <camera name="frontal" pos="0 -3.0 1.0" xyaxes="1 0 0 0 0.03 1"/>
    <camera name="lado" pos="3.0 0 1.0" xyaxes="0 1 0 0 0.03 1"/>
    <camera name="seguir" pos="0 -3.0 1.0" xyaxes="1 0 0 0 0.03 1" mode="trackcom"/>
    <geom name="chao" type="plane" size="4 4 0.05" material="piso"/>
    <!-- suporte visual do pivô (sem colisão: é decoração) -->
    <geom name="suporte" type="box" size="0.30 0.06 0.03" pos="0 0 1.53" material="aco" contype="0" conaffinity="0"/>
    <geom name="coluna" type="capsule" fromto="0 0 1.53 0 0 1.50" size="0.03" material="aco" contype="0" conaffinity="0"/>
    <body name="haste" pos="0 0 1.5">
      <joint name="pivo" type="hinge" axis="0 1 0" damping="0"/>
      <geom name="barra" type="capsule" fromto="0 0 0 0 0 -0.80" size="0.012" density="500" material="aco"/>
      <geom name="massa" type="sphere" pos="0 0 -0.80" size="0.07" density="2000" material="laranja"/>
      <!-- `ponta` é o ponto onde o `env.py` aplica a perturbação (e onde se lê o braço de alavanca) -->
      <site name="ponta" pos="0 0 -0.80" size="0.015" rgba="1 0.15 0.15 1"/>
      <!-- alvo visual: roda com a haste e marca o alvo no chão (só para o olho humano ver o objetivo) -->
      <site name="marca_alvo" pos="0 0 -0.80" size="0.008" rgba="0.15 1 0.35 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Um atuador de torque na junta. `gear="1"` = ctrl em N·m. `<motor>` não tem dinâmica (o comando é
         instantâneo); para atraso de ESC/motor usa `<general … dyntype="filterexact" dynprm="0.02">`. -->
    <motor name="torque" joint="pivo" gear="1" ctrlrange="-30 30"/>
  </actuator>

  <sensor>
    <jointpos name="theta" joint="pivo"/>
    <jointvel name="omega" joint="pivo"/>
    <jointactuatorfrc name="torque_aplicado" joint="pivo"/>
    <framepos name="ponta_pos" objtype="site" objname="ponta"/>
  </sensor>
</mujoco>
