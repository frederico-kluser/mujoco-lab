      ],
      "mode": "text",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "doc-oficial,api-c,{stem}"
    },
    {
      "name": "doc-oficial-tutoriais",
      "include": [
        "docs/upstream/mujoco/python/*.ipynb.md",
        "docs/upstream/mujoco/python/README.md",
        "docs/upstream/mujoco/mjx/**/*.md",
        "docs/upstream/mujoco/README.md",
        "docs/upstream/mujoco/VERSIONING.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "doc-oficial,tutorial,{stem}"
    },
    {
      "name": "doc-oficial-exemplos",
      "include": [
        "docs/upstream/mujoco/model/**/*.xml"
      ],
      "mode": "whole",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "exemplo-oficial,mjcf,{dir}"
    },
    {
      "name": "doc-oficial-irmaos",
      "include": [
        "docs/upstream/mujoco_warp/**/*.md",
        "docs/upstream/mujoco_playground/**/*.md",
        "docs/upstream/mujoco_mpc/**/*.md",
        "docs/upstream/mujoco_menagerie/**/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "doc-oficial,{dir},{stem}"
    }
