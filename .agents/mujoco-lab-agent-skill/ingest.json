      "mode": "markdown",
      "type": "semantic",
      "origin": "owner",
      "tags": "relatorio,owner,fonte-original"
    },
    {
      "name": "projeto",
      "include": [
        "AGENTS.md",
        "README.md",
        "experiments/*/README.md",
        "pesquisas/README.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "projeto,{dir},{stem}"
    },
    {
      "name": "skill-core",
      "include": [
        "docs/skill/SKILL.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "skill,mujoco-agent-skill"
    },
    {
      "name": "skill-referencias",
      "include": [
        "docs/skill/references/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "skill,referencia,{stem}"
    },
    {
      "name": "skill-templates-readme",
      "include": [
        "docs/skill/assets/templates/*/README.md"
      ],
      "mode": "markdown",
      "type": "procedural",
      "origin": "agent",
      "tags": "template,{dir}"
    },
    {
      "name": "skill-codigo",
      "include": [
        "docs/skill/scripts/*.py",
        "docs/skill/assets/templates/*/run.py",
        "docs/skill/assets/templates/*/model.xml"
      ],
      "mode": "whole",
      "type": "procedural",
      "origin": "agent",
      "tags": "codigo,{dir},{stem}"
    },
    {
      "name": "modelos",
      "include": [
        "models/*.xml"
      ],
      "mode": "whole",
      "type": "semantic",
      "origin": "agent",
      "tags": "mjcf,modelo,{stem}"
    },
    {
      "name": "experimentos-codigo",
      "include": [
        "experiments/*/run.py",
        "experiments/*/view.py"
      ],
      "mode": "whole",
      "type": "procedural",
      "origin": "agent",
      "tags": "experimento,codigo,{dir}"
    },
    {
      "name": "dossie",
      "include": [
        "pesquisas/20*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "pesquisa,dossie"
    },
    {
      "name": "fichas",
      "include": [
        "pesquisas/conhecimento/Q*.md",
        "pesquisas/conhecimento/_auditoria_bruta.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "pesquisa,ficha,{stem}"
    },
    {
      "name": "verificacao",
      "include": [
        "pesquisas/verificacao/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "pesquisa,verificacao"
    },
    {
      "name": "doc-oficial-skills",
      "include": [
        "docs/upstream/mujoco/doc/skills/*.md",
        "docs/upstream/mujoco/doc/skills/*/SKILL.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "doc-oficial,skill-oficial,{dir}"
    },
    {
      "name": "doc-oficial-rst",
      "include": [
        "docs/upstream/mujoco/doc/**/*.rst"
      ],
      "mode": "text",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "doc-oficial,mujoco,{stem}"
    },
    {
      "name": "doc-oficial-api-c",
      "include": [
