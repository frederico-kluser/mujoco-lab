<mujoco model="em_branco">
  <!-- Modelo mínimo: chão + uma caixa livre. Edite à vontade; guarde valores esperados em <custom><numeric> para validar em run.py. -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.05 0.05 0.05"/>
  </visual>
  <statistic center="0 0 0.5" extent="1.6"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.50 0.72 0.95" rgb2="0.03 0.05 0.10" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.19 0.23 0.29" rgb2="0.27 0.32 0.39" width="512" height="512" mark="edge" markrgb="0.55 0.60 0.66"/>
    <material name="piso" texture="grade" texrepeat="5 5" texuniform="true" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light name="sol" pos="1 -2 4" dir="-0.2 0.5 -1" type="directional" diffuse="0.85 0.85 0.85"/>
    <camera name="frontal" pos="0 -2.4 0.7" xyaxes="1 0 0 0 0.05 1"/>
    <geom name="chao" type="plane" size="4 4 0.05" material="piso" friction="0.8 0.005 0.0001" solref="0.01 0.6"/>
    <body name="alvo" pos="0 0 0.8" euler="10 15 0">
      <freejoint name="livre"/>
      <geom name="caixa" type="box" size="0.1 0.1 0.1" density="1000" rgba="0.96 0.47 0.10 1" friction="0.8 0.005 0.0001" solref="0.01 0.6"/>
    </body>
  </worldbody>
</mujoco>
