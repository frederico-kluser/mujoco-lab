<mujoco model="quadricoptero">
  <!--
    Quadricóptero em X (≈0.9 kg, braço 0.18 m). Empuxo por 4 atuadores <motor> aplicados em SITES nos rotores: o motor aplica uma força ao longo do eixo z do site
    (gear="0 0 1 …") — o momento em torno do centro de massa surge sozinho do braço de alavanca — e o torque reativo de guinada vem dos 3 últimos números do gear
    (± k_m·empuxo, sinais alternados: rotores adjacentes giram em sentidos opostos).
    ctrl = empuxo de cada rotor em newtons (0 … 8 N; empuxo de pairar por rotor = m·g/4 ≈ 2.2 N → relação empuxo/peso ≈ 3.6).
    Convenções: +Z para cima; frente = +X; rotores 1(+X,+Y) 2(−X,+Y) 3(−X,−Y) 4(+X,−Y). Ar/vento: ligue density/viscosity/wind em <option> (ou run.py --ar --vento).
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" density="0" viscosity="0" wind="0 0 0"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.05 0.05 0.05"/>
  </visual>
  <statistic center="0.5 0.5 0.8" extent="2.5"/>

  <default>
    <geom contype="0" conaffinity="0"/>   <!-- por omissão, sem colisão; só o chão e as pernas colidem (contype/conaffinity abaixo) -->
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.50 0.72 0.95" rgb2="0.03 0.05 0.10" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.19 0.23 0.29" rgb2="0.27 0.32 0.39" width="512" height="512" mark="edge" markrgb="0.55 0.60 0.66"/>
    <material name="piso" texture="grade" texrepeat="2 2" texuniform="true" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="sol" pos="2 -3 6" dir="-0.3 0.5 -1" type="directional" diffuse="0.85 0.85 0.85"/>
    <camera name="fixa" pos="0.5 -2.1 2.0" xyaxes="1 0 0 0 0.45 0.89"/>
    <geom name="chao" type="plane" size="12 12 0.05" material="piso" contype="1" conaffinity="1" friction="0.8 0.005 0.0001" solref="0.01 1"/>
    <!-- marcadores dos waypoints (visuais) -->
    <geom type="cylinder" size="0.12 0.002" pos="0 0 0.002" rgba="0.2 0.9 0.4 0.6"/>
    <geom type="cylinder" size="0.10 0.002" pos="1 0 0.002" rgba="0.9 0.8 0.2 0.5"/>
    <geom type="cylinder" size="0.10 0.002" pos="1 1 0.002" rgba="0.9 0.8 0.2 0.5"/>
    <geom type="cylinder" size="0.10 0.002" pos="0 1 0.002" rgba="0.9 0.8 0.2 0.5"/>

    <body name="drone" pos="0 0 0.06">
      <freejoint name="livre"/>
      <camera name="seguir" mode="trackcom" pos="-1.3 -1.6 0.55" xyaxes="0.78 -0.63 0 0.17 0.21 0.96"/>
      <geom name="corpo"  type="box" size="0.07 0.07 0.02" mass="0.60" rgba="0.14 0.15 0.19 1"/>
      <geom name="braco1" type="capsule" fromto="0 0 0  0.127  0.127 0" size="0.008" mass="0.02" rgba="0.3 0.32 0.38 1"/>
      <geom name="braco2" type="capsule" fromto="0 0 0 -0.127  0.127 0" size="0.008" mass="0.02" rgba="0.3 0.32 0.38 1"/>
      <geom name="braco3" type="capsule" fromto="0 0 0 -0.127 -0.127 0" size="0.008" mass="0.02" rgba="0.3 0.32 0.38 1"/>
      <geom name="braco4" type="capsule" fromto="0 0 0  0.127 -0.127 0" size="0.008" mass="0.02" rgba="0.3 0.32 0.38 1"/>
      <!-- motores (massa) + hélices (visuais). Os dois da frente (+X) são vermelhos -->
      <geom name="mot1" type="cylinder" size="0.02 0.012" pos=" 0.127  0.127 0.0" mass="0.05" rgba="0.9 0.2 0.2 1"/>
      <geom name="mot2" type="cylinder" size="0.02 0.012" pos="-0.127  0.127 0.0" mass="0.05" rgba="0.2 0.2 0.25 1"/>
      <geom name="mot3" type="cylinder" size="0.02 0.012" pos="-0.127 -0.127 0.0" mass="0.05" rgba="0.2 0.2 0.25 1"/>
      <geom name="mot4" type="cylinder" size="0.02 0.012" pos=" 0.127 -0.127 0.0" mass="0.05" rgba="0.9 0.2 0.2 1"/>
      <geom type="cylinder" size="0.085 0.002" pos=" 0.127  0.127 0.016" mass="0" rgba="0.5 0.7 1 0.28"/>
      <geom type="cylinder" size="0.085 0.002" pos="-0.127  0.127 0.016" mass="0" rgba="0.5 0.7 1 0.28"/>
      <geom type="cylinder" size="0.085 0.002" pos="-0.127 -0.127 0.016" mass="0" rgba="0.5 0.7 1 0.28"/>
      <geom type="cylinder" size="0.085 0.002" pos=" 0.127 -0.127 0.016" mass="0" rgba="0.5 0.7 1 0.28"/>
      <!-- pernas (únicas partes que colidem com o chão) -->
      <geom name="perna1" type="sphere" size="0.012" pos=" 0.127  0.127 -0.045" mass="0.003" contype="2" conaffinity="1" friction="0.8 0.005 0.0001" solref="0.01 1" rgba="0.1 0.1 0.1 1"/>
      <geom name="perna2" type="sphere" size="0.012" pos="-0.127  0.127 -0.045" mass="0.003" contype="2" conaffinity="1" friction="0.8 0.005 0.0001" solref="0.01 1" rgba="0.1 0.1 0.1 1"/>
      <geom name="perna3" type="sphere" size="0.012" pos="-0.127 -0.127 -0.045" mass="0.003" contype="2" conaffinity="1" friction="0.8 0.005 0.0001" solref="0.01 1" rgba="0.1 0.1 0.1 1"/>
      <geom name="perna4" type="sphere" size="0.012" pos=" 0.127 -0.127 -0.045" mass="0.003" contype="2" conaffinity="1" friction="0.8 0.005 0.0001" solref="0.01 1" rgba="0.1 0.1 0.1 1"/>
      <site name="rotor1" pos=" 0.127  0.127 0.016" size="0.01" rgba="1 0.2 0.2 1"/>
      <site name="rotor2" pos="-0.127  0.127 0.016" size="0.01" rgba="0.5 0.5 0.6 1"/>
      <site name="rotor3" pos="-0.127 -0.127 0.016" size="0.01" rgba="0.5 0.5 0.6 1"/>
      <site name="rotor4" pos=" 0.127 -0.127 0.016" size="0.01" rgba="1 0.2 0.2 1"/>
      <site name="imu" pos="0 0 0" size="0.01"/>
    </body>
  </worldbody>

  <actuator>
    <!-- gear = (fx fy fz  tx ty tz) no referencial do site: empuxo ao longo de +z do site e torque reativo de guinada ∓0.02·empuxo -->
    <motor name="m1" site="rotor1" gear="0 0 1 0 0 -0.02" ctrlrange="0 8"/>
    <motor name="m2" site="rotor2" gear="0 0 1 0 0  0.02" ctrlrange="0 8"/>
    <motor name="m3" site="rotor3" gear="0 0 1 0 0 -0.02" ctrlrange="0 8"/>
    <motor name="m4" site="rotor4" gear="0 0 1 0 0  0.02" ctrlrange="0 8"/>
  </actuator>

  <sensor>
    <gyro name="gyro" site="imu"/>
    <accelerometer name="acc" site="imu"/>
    <framepos name="pos" objtype="site" objname="imu"/>
    <framequat name="quat" objtype="site" objname="imu"/>
  </sensor>
</mujoco>
