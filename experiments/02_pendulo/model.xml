<mujoco model="pendulo">
  <!--
    Pêndulo físico: barra (cápsula, densidade 500) + massa esférica (densidade 2000) presas a uma junta hinge no eixo Y.
    Sem amortecimento nem atrito: a energia mecânica deve se conservar, o que torna o modelo um ÓTIMO teste de integrador/timestep.
    Ângulo da junta θ = 0 com a barra pendurada para baixo (-Z); qpos[0] em radianos (a junta é lida em rad mesmo com angle="degree" no XML).
    Período analítico de pequenas oscilações: T0 = 2π·√(I_pivô / (m·g·d)) — run.py calcula I_pivô, m e d a partir do modelo compilado.
  -->
  <compiler angle="degree"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.05 0.05 0.05"/>
  </visual>
  <statistic center="0 0 1.0" extent="1.6"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.50 0.72 0.95" rgb2="0.03 0.05 0.10" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.19 0.23 0.29" rgb2="0.27 0.32 0.39" width="512" height="512" mark="edge" markrgb="0.55 0.60 0.66"/>
    <material name="piso" texture="grade" texrepeat="5 5" texuniform="true" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="sol" pos="1 -2 4" dir="-0.2 0.5 -1" type="directional" diffuse="0.85 0.85 0.85"/>
    <camera name="frontal" pos="0 -3.0 1.0" xyaxes="1 0 0 0 0.03 1"/>
    <geom name="chao" type="plane" size="4 4 0.05" material="piso"/>
    <!-- suporte visual (sem colisão) -->
    <geom name="suporte" type="box" size="0.35 0.06 0.03" pos="0 0 1.53" rgba="0.6 0.62 0.68 1" contype="0" conaffinity="0"/>
    <body name="haste" pos="0 0 1.5">
      <joint name="pivo" type="hinge" axis="0 1 0" damping="0"/>
      <geom name="barra"  type="capsule" fromto="0 0 0 0 0 -0.80" size="0.012" density="500"  rgba="0.85 0.86 0.9 1"/>
      <geom name="massa"  type="sphere"  pos="0 0 -0.80"           size="0.07"  density="2000" rgba="0.96 0.47 0.10 1"/>
      <site name="ponta" pos="0 0 -0.80" size="0.015" rgba="1 0.1 0.1 1"/>
    </body>
  </worldbody>

  <sensor>
    <jointpos name="theta"  joint="pivo"/>
    <jointvel name="omega"  joint="pivo"/>
  </sensor>
</mujoco>
