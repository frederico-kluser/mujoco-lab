<mujoco model="haste_pendulo_forcado">
  <!--
    Variante estável do exemplo do relatório: a haste PENDURADA (CM 0.40 m ABAIXO do pivô) com amortecimento viscoso na junta (c = 0.5 N·m·s/rad), movida por torque senoidal de 15 N·m a 1 Hz.
    É um pêndulo forçado: I·θ'' + c·θ' + m·g·d·sinθ = T·sin(ωt). O run.py compara a simulação com a EDO não linear (scipy). O pivô está a 1.0 m do chão para a haste não tocá-lo.
  -->
  <option timestep="0.002" integrator="implicitfast"/>
  <visual><global offwidth="1280" offheight="720"/></visual>
  <statistic center="0 0 0.8" extent="1.8"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.7 0.95" rgb2="0.05 0.07 0.12" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.2 0.24 0.3" rgb2="0.28 0.33 0.4" width="512" height="512" mark="edge" markrgb="0.55 0.6 0.66"/>
    <material name="piso" texture="grade" texrepeat="6 6" texuniform="true" reflectance="0"/>
  </asset>
  <worldbody>
    <light pos="0 1 2" dir="0 -1 -1" type="directional" diffuse="0.9 0.9 0.9"/>
    <camera name="lateral" pos="0 -3.0 1.0" xyaxes="1 0 0 0 0.25 1"/>
    <geom name="chao" type="plane" size="3 3 0.1" material="piso"/>
    <body name="base_robotica" pos="0 0 1.0">
      <geom name="caixa" type="box" size="0.2 0.2 0.2" rgba="0.3 0.3 0.3 1"/>
      <body name="haste_articulada" pos="0 0.26 0">
        <joint name="junta_motor" type="hinge" axis="0 1 0" damping="0.5"/>
        <geom name="haste" type="cylinder" size="0.05 0.4" pos="0 0 -0.4" rgba="0.8 0.2 0.2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="atuador_principal" joint="junta_motor" gear="1"/>
  </actuator>
</mujoco>
