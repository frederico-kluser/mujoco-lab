<mujoco model="haste_relatorio">
  <!--
    Exemplo do §4.2 do relatório técnico do usuário (haste articulada acionada por motor), CORRIGIDO para o MuJoCo 3.15.0.
    Mudança essencial: pos="0 0.26 0" no corpo da haste (no original 0.2). Base soldada ao mundo ⇒ NÃO existe filtro pai-filho: com 0.2 a haste (raio 0.05) penetrava 5 cm na caixa,
    gerando contato permanente que travava a junta (|θ| ≤ 0.005 rad). Alternativa: <contact><exclude body1="base_robotica" body2="haste_articulada"/></contact>.
    A haste está "de cabeça para cima" (CM 0.40 m acima do pivô; m·g·d = 24.7 N·m > 15 N·m do motor): ela cai e oscila; para um pêndulo estável use pos="0 0 -0.4" no geom.
  -->
  <option timestep="0.005"/>
  <visual><global offwidth="1280" offheight="720"/></visual>
  <statistic center="0 0 0.5" extent="1.6"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.7 0.95" rgb2="0.05 0.07 0.12" width="512" height="3072"/>
    <texture name="grade" type="2d" builtin="checker" rgb1="0.2 0.24 0.3" rgb2="0.28 0.33 0.4" width="512" height="512" mark="edge" markrgb="0.55 0.6 0.66"/>
    <material name="piso" texture="grade" texrepeat="6 6" texuniform="true" reflectance="0"/>
  </asset>
  <worldbody>
    <light pos="0 1 2" dir="0 -1 -1" type="directional" diffuse="0.9 0.9 0.9"/>
    <camera name="lateral" pos="0 -2.6 0.9" xyaxes="1 0 0 0 0.3 1"/>
    <geom name="chao" type="plane" size="3 3 0.1" material="piso"/>
    <body name="base_robotica" pos="0 0 0.5">
      <geom name="caixa" type="box" size="0.2 0.2 0.2" rgba="0.3 0.3 0.3 1"/>
      <body name="haste_articulada" pos="0 0.26 0">
        <joint name="junta_motor" type="hinge" axis="0 1 0"/>
        <geom name="haste" type="cylinder" size="0.05 0.4" pos="0 0 0.4" rgba="0.8 0.2 0.2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="atuador_principal" joint="junta_motor" gear="1"/>
  </actuator>
</mujoco>
